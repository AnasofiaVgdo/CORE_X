# Optional overrides for Docker Compose. Defaults allow `docker compose up --build`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=noonas_db
SECRET_KEY=replace-with-a-long-random-value

# URL publica de la API que usa el navegador. Vacio = mismo origen (proxy nginx en /api).
# Ej: http://127.0.0.1:8000 o https://api.midominio.com
API_URL=
